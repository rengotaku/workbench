<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  todo-order server as a login agent.

  Placed by `make install-agent`, which fills in __HOME__ and __PORT__. The
  server binds loopback only and has no authentication, so LISTEN_ADDR is
  pinned here rather than left to the environment.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.todo-order.server</string>

    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.local/bin/todo-order-server</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>LISTEN_ADDR</key>
        <string>127.0.0.1</string>
        <key>PORT</key>
        <string>__PORT__</string>
        <key>DATA_DIR</key>
        <string>__HOME__/.local/share/todo-order</string>
        <key>APP_ENV</key>
        <string>production</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/todo-order/server.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/todo-order/server.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
